# MEXC API key needs Futures trading permission only; NEVER enable withdrawals.
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=

# Safety defaults: paper mode until you have tested signals and exchange access.
AUTO_TRADING_ENABLED=false
REAL_TRADING_ENABLED=false

# Risk and scan settings
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
ENTRY_TIMEFRAME=15m
TREND_TIMEFRAME=1h
BIAS_TIMEFRAME=4h
LEVERAGE=10
TRADE_AMOUNT_USDT=5
MAX_OPEN_POSITIONS=3
MAX_SAME_DIRECTION_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=10
MAX_TRADES_PER_DAY=6
LOSS_COOLDOWN_MINUTES=60
ENTRY_COOLDOWN_MINUTES=30
BREAKOUT_LOOKBACK=20
ATR_PERIOD=14
MIN_RR=2
STOP_ATR_MULTIPLIER=1.5
TAKE_PROFIT_R=2.5
SCAN_INTERVAL_SECONDS=60
PORT=3000
